---
import MapView, { type MapPin } from "./MapView.tsx";
import MarginLines from "./MarginLines.astro";

interface Props {
  pines: MapPin[];
}

const { pines } = Astro.props;

// Solo Recoleta y Palermo como cards destacadas (ahí trabajamos
// principalmente); Balvanera sigue existiendo como zona real de deptos
// puntuales (filtro, mapa), pero no se destaca acá.
const zonas = [
  {
    nombre: "Recoleta",
    subtitulo: "Clínicas, facultades y avenidas",
    texto:
      "Una zona cómoda, segura y muy buscada por quienes necesitan moverse rápido por la ciudad. Ideal para pacientes, familias y estadías cortas, cerca de clínicas, facultades y Av. Santa Fe.",
  },
  {
    nombre: "Palermo",
    subtitulo: "Gastronomía, bares y vida urbana",
    texto:
      "Moderno y conectado: ideal para quienes quieren estar cerca de restaurantes, bares, transporte y puntos turísticos de la ciudad.",
  },
];

const accesos = [
  {
    texto: "Subte y colectivos a pocas cuadras",
    path: "M6 3h12a2 2 0 0 1 2 2v9a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V5a2 2 0 0 1 2-2z M4 12h16 M8 20l-1.5 2 M17 20l1.5 2",
  },
  {
    texto: "Hospitales y clínicas cercanas",
    path: "M4 4h16v16H4z M12 8v8 M8 12h8",
  },
  {
    texto: "Zonas seguras y muy transitadas",
    path: "M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z",
  },
  {
    texto: "Conexión rápida con el resto de CABA",
    path: "M12 2l7 19-7-4-7 4z",
  },
];

// Mismos centros aproximados usados al asignar zona/coords a cada depto
// (ver script de carga de datos): solo para ubicar el nombre del barrio en
// el mapa general, no la posición real de ningún depto puntual. Se dejan
// las 3 acá aunque las cards de arriba muestren solo Recoleta y Palermo,
// porque en el mapa sí aparecen deptos reales en Balvanera también.
const etiquetasZona = [
  { nombre: "Recoleta", lat: -34.5895, lng: -58.3927 },
  { nombre: "Palermo", lat: -34.5875, lng: -58.4306 },
  { nombre: "Balvanera", lat: -34.6008, lng: -58.3931 },
];
---

<section id="zonas" class="relative border-y border-hairline bg-surface">
  <MarginLines side="left" />
  <div class="mx-auto max-w-[90rem] px-4 py-16 sm:px-6 lg:py-24">
    <h2 class="font-display text-3xl text-ink sm:text-4xl">Trabajamos en zonas céntricas, prácticas y cercanas a todo.</h2>
    <p class="mt-3 max-w-2xl font-body text-base text-muted">
      Nuestra propuesta se enfoca principalmente en Recoleta y Palermo, dos
      zonas muy elegidas de Buenos Aires por su ubicación, movimiento,
      seguridad y cercanía con clínicas, facultades, comercios, restaurantes,
      transporte público y avenidas principales.
    </p>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <div class="grid gap-6 lg:grid-rows-2">
        {
          zonas.map((z) => (
            <div class="group rounded-2xl border border-hairline bg-canvas p-6 transition-all duration-300 hover:-translate-y-1 hover:border-gold-active hover:shadow-xl hover:shadow-ink/10">
              <h3 class="font-display text-2xl text-ink">{z.nombre}</h3>
              <p class="mt-1 font-body text-sm font-semibold text-gold-active">{z.subtitulo}</p>
              <p class="mt-3 font-body text-sm text-muted">{z.texto}</p>
              <a
                href={`/departamentos?zona=${encodeURIComponent(z.nombre)}`}
                class="mt-4 inline-flex items-center gap-1.5 font-body text-sm font-semibold text-gold-active hover:text-gold"
              >
                Ver departamentos en {z.nombre}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            </div>
          ))
        }
      </div>

      <div class="h-96 overflow-hidden rounded-2xl bg-canvas lg:h-full">
        <MapView client:only="preact" pines={pines} className="h-full w-full" etiquetasZona={etiquetasZona} />
      </div>
    </div>

    <div class="mt-8 rounded-2xl border border-hairline bg-canvas p-6">
      <p class="font-body text-sm font-semibold uppercase tracking-wide text-muted">Todas estas zonas cuentan con:</p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          accesos.map((a) => (
            <div class="flex items-center gap-3 rounded-xl border border-hairline bg-surface p-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-gold-active hover:shadow-lg hover:shadow-ink/10">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-canvas text-gold-active">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={a.path} />
                </svg>
              </span>
              <span class="font-body text-sm text-ink">{a.texto}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
