---
// Motivo de marca: el skyline del logo, redibujado como vector propio (no el
// raster) para poder usarlo grande, animado y a cualquier tamaño sin perder
// nitidez. Aparece una sola vez con peso real (hero); en el resto del sitio
// se evita para que no se vuelva papel tapiz.
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 620 360"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  role="presentation"
>
  <g stroke="var(--color-gold)" stroke-width="5" stroke-linejoin="round" class="skyline-buildings">
    <path d="M40 300V150l70-46v196" style="--i:0" />
    <path d="M110 300V104l90-64v260" style="--i:1" />
    <path d="M200 300V190l55-38v148" style="--i:2" />
    <path d="M255 300V70l85 58v172" style="--i:3" />
    <path d="M340 300V162l60-42v180" style="--i:4" />
    <path d="M400 300V118l78 54v128" style="--i:5" />
    <path d="M478 300V210l50-34v124" style="--i:6" />
  </g>
  <rect x="228" y="150" width="26" height="150" fill="var(--color-gold)" class="skyline-spine" />
  <path
    d="M10 312c110-34 190-34 300-4 96 27 190 8 300-20"
    stroke="var(--color-gold)"
    stroke-width="5"
    stroke-linecap="round"
    class="skyline-horizon"
  />
</svg>
