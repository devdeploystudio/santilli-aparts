---
import { getEntry } from "astro:content";
import { WHATSAPP_NUMBER } from "../config/site";
import { buildConsultaGeneralLink } from "../lib/whatsapp";
import HeroShowcase from "./HeroShowcase.tsx";

const waLink = buildConsultaGeneralLink(WHATSAPP_NUMBER);
const inicio = (await getEntry("configInicio", "inicio"))!.data;
---

<section id="hero" class="relative flex min-h-[calc(100svh-4.5rem)] overflow-hidden" data-no-reveal>
  <div class="relative mx-auto grid w-full max-w-[90rem] lg:grid-cols-[1fr_1.1fr]">
    <div class="flex flex-col justify-center px-5 py-16 sm:px-7 sm:py-20 lg:order-2 lg:pl-12 xl:pl-20">
      <div class="max-w-2xl">
        {/* clamp en vez de breakpoints fijos (sm:text-6xl lg:text-7xl): con un
        salto fijo justo en el breakpoint donde arranca el layout de 2
        columnas (1024px), esta columna se queda con menos ancho de golpe y
        el título pasaba a ocupar 3-4 líneas en vez de 2 en pantallas de
        notebook, empujando el hero mucho más alto que una pantalla en esos
        anchos puntuales aunque se viera bien en un monitor más ancho. El
        clamp escala el tamaño de forma continua con el ancho, sin ese salto. */}
        <h1 class="font-display text-[clamp(2.75rem,4vw+1rem,4.5rem)] leading-[1.05] text-ink">
          {inicio.heroTitulo}
        </h1>

        <p class="mt-7 max-w-xl font-body text-lg leading-relaxed text-muted sm:text-xl">
          Contamos con <span class="ink-underline font-semibold text-ink" style="--delay:825ms">{inicio.heroDestacado1}</span>{" "}
          en Recoleta y Palermo, para <span class="ink-underline font-semibold text-ink" style="--delay:1050ms">{inicio.heroDestacado2}</span>,{" "}
          y no pedimos seña: <span class="ink-underline font-semibold text-ink" style="--delay:1275ms">{inicio.heroDestacado3}</span>.{" "}
          Te asesoramos de manera personalizada según fechas, zona y cantidad de huéspedes, y siempre te atiende la misma familia.
        </p>

        <div class="mt-9 flex flex-wrap gap-4">
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            data-ubicacion="hero"
            class="btn-press rounded-full bg-gold px-6 py-3.5 font-body text-sm font-semibold text-ink shadow-[0_8px_24px_-8px_rgb(204_160_56/0.6)] hover:bg-gold-active"
          >
            Consultar por WhatsApp
          </a>
          <a
            href="/departamentos"
            class="btn-press rounded-full border border-hairline bg-surface px-6 py-3.5 font-body text-sm font-semibold text-ink hover:border-gold-active hover:text-gold-active"
          >
            Ver departamentos
          </a>
        </div>
      </div>
    </div>

    <div class="order-first h-64 sm:h-96 lg:order-1 lg:h-auto lg:ml-[min(0px,calc((90rem-100vw)/2))]">
      <HeroShowcase client:visible slides={inicio.heroSlides} />
    </div>
  </div>
</section>

<script>
  // El gesto de entrada (skyline + subrayados) queda afuera del sistema
  // genérico de ScrollReveal (data-no-reveal), pero igual se re-juega cada
  // vez que el hero vuelve a estar en pantalla: se saca la clase al salir
  // y se vuelve a poner al entrar, forzando reflow en el medio para que la
  // animación CSS (que solo corre en su transición inicial) arranque de
  // cero en vez de quedar "ya terminada".
  const hero = document.getElementById("hero");

  if (hero) {
    const reducirMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reducirMovimiento || !("IntersectionObserver" in window)) {
      hero.classList.add("hero-in-view");
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              hero.classList.remove("hero-in-view");
              void hero.offsetWidth;
              hero.classList.add("hero-in-view");
            } else {
              hero.classList.remove("hero-in-view");
            }
          }
        },
        { threshold: 0.3 },
      );

      observer.observe(hero);
    }
  }
</script>
