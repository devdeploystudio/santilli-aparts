---
import { getEntry } from "astro:content";
import { WHATSAPP_NUMBER } from "../config/site";
import { buildConsultaGeneralLink } from "../lib/whatsapp";
import HeroShowcase from "./HeroShowcase.tsx";
import { imageSize } from "../lib/imageSize";

const waLink = buildConsultaGeneralLink(WHATSAPP_NUMBER);
const inicio = (await getEntry("configInicioHero", "inicioHero"))!.data;
const fotos = (await getEntry("configInicioFotos", "inicioFotos"))!.data;
// null para los slides de video (sharp no lee dimensiones de mp4) - queda
// igual que antes para esos, HeroShowcase ya maneja width/height opcionales.
const heroSlidesConTamaño = await Promise.all(
  fotos.heroSlides.map(async (s) => ({ ...s, ...((await imageSize(s.archivo)) ?? {}) })),
);
---

{/* --header-h la fija Header.astro (ResizeObserver, alto real medido) -
   el 4.5rem acá es solo el fallback antes de que ese script corra, para
   no dejar un salto visual en el primer paint. */}
<section id="hero" class="relative flex min-h-[calc(100svh-var(--header-h,4.5rem))] items-center overflow-hidden" data-no-reveal>
  {/* PRUEBA (sep 2026): fotos/video como fondo completo del Hero, con una
     capa oscura encima para que el texto blanco se lea bien. Versión
     anterior (2 columnas, texto a la derecha / vidriera a la izquierda)
     respaldada en Hero.astro.backup por si no convence. */}
  <div class="absolute inset-0">
    <HeroShowcase client:visible slides={heroSlidesConTamaño} />
    <div class="absolute inset-0 bg-ink/55" />
  </div>

  <div class="relative mx-auto w-full max-w-[90rem] px-7 py-20 sm:px-10 sm:py-24">
    <div class="max-w-2xl">
      {/* clamp en vez de breakpoints fijos (sm:text-6xl lg:text-7xl): con un
      salto fijo justo en el breakpoint donde arranca el layout de 2
      columnas (1024px), esta columna se queda con menos ancho de golpe y
      el título pasaba a ocupar 3-4 líneas en vez de 2 en pantallas de
      notebook, empujando el hero mucho más alto que una pantalla en esos
      anchos puntuales aunque se viera bien en un monitor más ancho. El
      clamp escala el tamaño de forma continua con el ancho, sin ese salto. */}
      <h1 class="font-display text-[clamp(2.75rem,4vw+1rem,4.5rem)] leading-[1.05] text-canvas">
        {inicio.heroTitulo}
      </h1>

      <p class="mt-7 max-w-xl font-body text-lg leading-relaxed text-canvas/85 sm:text-xl">
        {inicio.heroPre} <span class="ink-underline font-semibold text-canvas" style="--delay:825ms">{inicio.heroDestacado1}</span>{" "}
        {inicio.heroEntre1} <span class="ink-underline font-semibold text-canvas" style="--delay:1050ms">{inicio.heroDestacado2}</span>,{" "}
        {inicio.heroEntre2} <span class="ink-underline font-semibold text-canvas" style="--delay:1275ms">{inicio.heroDestacado3}</span>.{" "}
        {inicio.heroFinal}
      </p>

      <div class="mt-9 flex flex-wrap gap-4">
        <a
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          data-ubicacion="hero"
          class="btn-press rounded-full bg-gold px-6 py-3.5 font-body text-sm font-semibold text-ink shadow-[0_8px_24px_-8px_rgb(204_160_56/0.6)] hover:bg-gold-active"
        >
          {inicio.botonWhatsappTexto}
        </a>
        <a
          href="/departamentos/"
          class="btn-press rounded-full border border-hairline bg-surface px-6 py-3.5 font-body text-sm font-semibold text-ink hover:border-gold-active hover:text-gold-active"
        >
          {inicio.botonDeptosTexto}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // El gesto de entrada (skyline + subrayados) queda afuera del sistema
  // genérico de ScrollReveal (data-no-reveal), pero igual se re-juega cada
  // vez que el hero vuelve a estar en pantalla: se saca la clase al salir
  // y se vuelve a poner al entrar, forzando reflow en el medio para que la
  // animación CSS (que solo corre en su transición inicial) arranque de
  // cero en vez de quedar "ya terminada".
  const hero = document.getElementById("hero");

  if (hero) {
    const reducirMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reducirMovimiento || !("IntersectionObserver" in window)) {
      hero.classList.add("hero-in-view");
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              hero.classList.remove("hero-in-view");
              void hero.offsetWidth;
              hero.classList.add("hero-in-view");
            } else {
              hero.classList.remove("hero-in-view");
            }
          }
        },
        { threshold: 0.3 },
      );

      observer.observe(hero);
    }
  }
</script>
