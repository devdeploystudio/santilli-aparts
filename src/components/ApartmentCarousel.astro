---
// Estructura y script portados tal cual del carrusel "A quién apuntamos" de
// estudio-3s_santino (proyecto hermano de Deploy) — mismo código para
// desktop y mobile, sin ramas por dispositivo. La tira NO usa scroll nativo
// (overflow-x/scrollLeft): se mueve con transform: translateX vía JS, así
// se evita la familia de bugs de iOS Safari donde el scrollLeft/contentSize
// interno no se actualiza bien. Ver notas en el <script> más abajo.
import PlaceholderPhoto from "./PlaceholderPhoto.astro";

export interface CarruselDepto {
  slug: string;
  nombre: string;
  zona: string;
  esPlaceholder: boolean;
  foto: string;
  video?: string;
  videoPoster?: string;
}

interface Props {
  deptos: CarruselDepto[];
}

const { deptos } = Astro.props;
---

{
  deptos.length > 0 && (
    <div class="depto-carousel">
      <div class="depto-carousel__viewport">
        <div class="depto-carousel__track">
          {deptos.map((d) => (
            <div class="depto-carousel__item">
              <a
                href={`/departamentos/${d.slug}`}
                class="depto-card group relative block overflow-hidden rounded-2xl border border-hairline bg-surface transition-shadow duration-300 hover:shadow-xl hover:shadow-ink/10"
              >
                <div class="relative aspect-[4/3] overflow-hidden">
                  {d.video ? (
                    <video
                      src={d.video}
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  ) : d.esPlaceholder ? (
                    <PlaceholderPhoto class="h-full w-full transition-transform duration-300 group-hover:scale-105" />
                  ) : (
                    <img
                      src={d.foto}
                      alt={`Foto de ${d.nombre}`}
                      loading="lazy"
                      draggable="false"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  )}
                  <span class="absolute left-3 top-3 rounded-full bg-surface/90 px-3 py-1 font-body text-xs font-semibold text-ink backdrop-blur-sm">
                    {d.zona}
                  </span>
                </div>
                <div class="flex items-start justify-between gap-3 p-5">
                  <h3 class="line-clamp-2 min-h-[3.5rem] font-display text-lg text-ink">{d.nombre}</h3>
                  <svg class="depto-card__arrow mt-1 h-4 w-4 shrink-0 text-gold-active" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </div>
                <span class="depto-card__accent absolute inset-x-0 bottom-0 h-[3px] bg-gold" />
              </a>
            </div>
          ))}
        </div>
      </div>

      <div class="depto-carousel__nav">
        <button type="button" class="depto-carousel__nav-btn depto-carousel__nav-btn--prev" aria-label="Ver departamento anterior">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </button>
        <button type="button" class="depto-carousel__nav-btn depto-carousel__nav-btn--next" aria-label="Ver siguiente departamento">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 6l6 6-6 6" />
          </svg>
        </button>
      </div>
    </div>
  )
}

<style>
  .depto-carousel {
    position: relative;
  }

  .depto-carousel__viewport {
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
    -webkit-user-select: none;
    user-select: none;
  }

  .depto-carousel__viewport.is-dragging {
    cursor: grabbing;
  }

  .depto-carousel__track {
    display: flex;
    flex-wrap: nowrap;
    will-change: transform;
    gap: 1.5rem;
  }

  .depto-carousel__item {
    flex: 0 0 85%;
  }

  .depto-carousel__item a {
    -webkit-user-drag: none;
  }

  @media (min-width: 640px) {
    .depto-carousel__item {
      flex-basis: calc(50% - 0.75rem);
    }
  }

  @media (min-width: 1024px) {
    .depto-carousel__item {
      flex-basis: calc(100% / 3 - 1rem);
    }
  }

  .depto-carousel__nav {
    margin-top: 1.5rem;
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .depto-carousel__nav-btn {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid var(--color-hairline);
    color: var(--color-ink);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .depto-carousel__nav-btn:hover {
    border-color: var(--color-gold-active);
    color: var(--color-gold-active);
  }
</style>

<script>
  // Portado tal cual del carrusel "A quién apuntamos" de estudio-3s_santino
  // (deploy_), que funciona bien tanto en desktop como en mobile con el
  // MISMO código (sin ramas por tipo de dispositivo). La diferencia clave
  // contra soluciones con scroll nativo: la tira NO usa overflow-x/scrollLeft
  // — se mueve con transform: translateX vía JS, así se evita por completo
  // la familia de bugs de iOS Safari donde el scrollLeft/contentSize interno
  // no se actualiza bien (causa real de "scroll infinito" en loops caseros
  // con scroll nativo). El drag funciona igual con mouse y con dedo
  // (pointer events + touch-action: pan-y para dejar pasar el scroll
  // vertical de la página).
  function initDeptoCarousel() {
    const viewport = document.querySelector<HTMLElement>(".depto-carousel__viewport");
    const track = document.querySelector<HTMLElement>(".depto-carousel__track");
    const container = document.querySelector<HTMLElement>(".depto-carousel");
    if (!viewport || !track || !container) return;
    if (track.dataset.cloned === "true") return;

    const originales = Array.from(track.children) as HTMLElement[];
    if (originales.length <= 1) return;

    track.dataset.cloned = "true";
    originales.forEach((item) => {
      const clon = item.cloneNode(true) as HTMLElement;
      clon.setAttribute("aria-hidden", "true");
      clon.querySelectorAll("a").forEach((a) => a.setAttribute("tabindex", "-1"));
      track.appendChild(clon);
    });

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const VELOCIDAD = 24; // px/s

    let setW = 0;
    let paso = 0;
    let pos = 0;
    let encima = false;
    let aLaVista = true;

    function medir() {
      const gap = parseFloat(getComputedStyle(track!).columnGap) || 0;
      paso = originales[0].getBoundingClientRect().width + gap;
      setW = originales.reduce((sum, item) => sum + item.getBoundingClientRect().width + gap, 0);
    }
    medir();
    window.addEventListener("resize", medir);

    function mover() {
      track!.style.transform = `translateX(${-pos}px)`;
    }

    new IntersectionObserver(
      ([e]) => {
        aLaVista = e.isIntersecting;
      },
      { threshold: 0.1 },
    ).observe(viewport);

    (["pointerenter", "focusin"] as const).forEach((ev) => viewport!.addEventListener(ev, () => (encima = true)));
    (["pointerleave", "focusout"] as const).forEach((ev) => viewport!.addEventListener(ev, () => (encima = false)));

    const clampPos = (p: number) => ((p % setW) + setW) % setW;

    container.querySelector(".depto-carousel__nav-btn--prev")?.addEventListener("click", () => {
      pos = clampPos(pos - paso);
      mover();
    });
    container.querySelector(".depto-carousel__nav-btn--next")?.addEventListener("click", () => {
      pos = clampPos(pos + paso);
      mover();
    });

    let arrastrando = false;
    let startX = 0;
    let startPos = 0;
    let velX = 0;
    let lastMoveX = 0;
    let lastMoveT = 0;

    viewport.addEventListener("pointerdown", (e) => {
      arrastrando = true;
      encima = true;
      startX = e.clientX;
      startPos = pos;
      lastMoveX = e.clientX;
      lastMoveT = performance.now();
      velX = 0;
      viewport!.setPointerCapture(e.pointerId);
      viewport!.classList.add("is-dragging");
    });

    let dragRaf: number | undefined;
    let pendingX = 0;
    viewport.addEventListener("pointermove", (e) => {
      if (!arrastrando) return;
      pendingX = e.clientX;
      if (dragRaf !== undefined) return;
      dragRaf = requestAnimationFrame(() => {
        dragRaf = undefined;
        const now = performance.now();
        const dt = now - lastMoveT;
        if (dt > 0) velX = (lastMoveX - pendingX) / dt;
        lastMoveX = pendingX;
        lastMoveT = now;
        pos = clampPos(startPos + (startX - pendingX));
        mover();
      });
    });

    function inercia() {
      let v = velX;
      let last = performance.now();
      function coast(now: number) {
        const dt = now - last;
        last = now;
        v *= Math.pow(0.94, dt / 16);
        if (Math.abs(v) < 0.02) {
          encima = false;
          return;
        }
        pos = clampPos(pos + v * dt);
        mover();
        requestAnimationFrame(coast);
      }
      coast(last);
    }
    function soltar() {
      if (!arrastrando) return;
      arrastrando = false;
      if (dragRaf !== undefined) {
        cancelAnimationFrame(dragRaf);
        dragRaf = undefined;
      }
      viewport!.classList.remove("is-dragging");
      if (Math.abs(velX) > 0.02) inercia();
      else encima = false;
    }
    viewport.addEventListener("pointerup", soltar);
    viewport.addEventListener("pointercancel", soltar);

    if (reduceMotion) return;

    let last = performance.now();
    requestAnimationFrame(function tick(now) {
      const dt = (now - last) / 1000;
      last = now;
      if (!encima && aLaVista) {
        pos = (pos + VELOCIDAD * dt) % setW;
        mover();
      }
      requestAnimationFrame(tick);
    });
  }

  initDeptoCarousel();
  document.addEventListener("astro:page-load", initDeptoCarousel);
</script>
