---
interface Props {
  class?: string;
  index?: number;
}

const { class: className = "", index = 0 } = Astro.props;
// Ligera variación entre placeholders para que una galería no se vea como
// una sola imagen repetida.
const angle = 135 + index * 15;
---

<div
  class={`flex items-center justify-center bg-canvas ${className}`}
  style={`background-image: linear-gradient(${angle}deg, color-mix(in srgb, var(--color-gold) 18%, var(--color-canvas)), var(--color-canvas));`}
>
  <div class="flex flex-col items-center gap-2 px-4 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold-active" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
      <circle cx="9" cy="10" r="2"></circle>
      <path d="M21 16l-5-5-4 4-3-3-6 6"></path>
    </svg>
    <span class="font-body text-xs font-medium text-muted">Foto próximamente</span>
  </div>
</div>
