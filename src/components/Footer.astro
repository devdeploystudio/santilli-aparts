---
import { SITE, WHATSAPP_NUMBER, INSTAGRAM_URL } from "../config/site";
import { buildConsultaGeneralLink } from "../lib/whatsapp";

const waLink = buildConsultaGeneralLink(WHATSAPP_NUMBER);
const anio = new Date().getFullYear();
const numeroLegible = `+${WHATSAPP_NUMBER.slice(0, 2)} ${WHATSAPP_NUMBER.slice(2, 3)} ${WHATSAPP_NUMBER.slice(3, 5)} ${WHATSAPP_NUMBER.slice(5, 9)}-${WHATSAPP_NUMBER.slice(9)}`;
// Deriva el @usuario del link completo (que se edita desde el panel) en vez
// de tenerlo escrito dos veces: si cambia el link, el texto se actualiza solo.
const instagramHandle = INSTAGRAM_URL?.replace(/\/+$/, "").split("/").pop();
---

<footer class="bg-ink">
  {/* flex + justify-between, no grid-cols-3: con columnas de ancho IGUAL,
     "Contacto" y "Diferenciales" (contenido corto) dejaban un montón de
     espacio vacío antes del borde de su propia columna - se veía como que
     el último bloque no llegaba al margen derecho, aunque su CAJA sí
     llegaba. Con flex, cada bloque mide lo que su contenido necesita de
     verdad, y justify-between reparte el espacio ENTRE los bloques reales
     (no entre cajas infladas) - así los 3 quedan a la misma distancia
     visual entre sí, y el último termina justo contra el margen. */}
  <div class="mx-auto flex max-w-[90rem] flex-col gap-10 px-0 py-14 sm:px-0 md:flex-row md:justify-between">
    <div class="md:max-w-xs">
      <a href="/" class="group inline-flex items-center gap-2.5">
        {/* aspect-[...] en vez de una caja cuadrada: el ícono real (ver
           public/icon-white.png) es rectangular (~1.27:1), no cuadrado -
           forzarlo a un cuadrado lo dejaba chico y con hueco arriba/abajo
           (object-contain letterboxeando). Con la caja ya en la proporción
           real, el dibujo la llena entera. */}
        <span class="relative h-7 aspect-[443/350] sm:h-8">
          <img src="/icon-white.png" alt="" width="443" height="350" loading="lazy" class="absolute inset-0 h-full w-full object-contain transition-opacity duration-200 group-hover:opacity-0" />
          <img src="/icon-gold.png" alt="" width="443" height="350" loading="lazy" class="absolute inset-0 h-full w-full object-contain opacity-0 transition-opacity duration-200 group-hover:opacity-100" />
        </span>
        <span class="font-display text-xl text-canvas transition-colors group-hover:text-gold">{SITE.nombre}</span>
      </a>
      <p class="mt-3 max-w-xs font-body text-sm text-canvas/65">
        Un negocio familiar: siempre te atiende la misma familia, de principio a
        fin de tu estadía en Recoleta, Palermo y Balvanera.
      </p>
    </div>

    <div>
      <p class="font-body text-sm font-semibold text-canvas">Contacto</p>
      <a href={waLink} target="_blank" rel="noopener noreferrer" data-ubicacion="footer" class="mt-3 flex items-center gap-2 font-body text-sm text-canvas/65 hover:text-gold">
        <svg viewBox="0 0 16 16" class="h-4 w-4 shrink-0 fill-current" aria-hidden="true">
          <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.005-.247-.005-.38-.005a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.99.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.337-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232" />
        </svg>
        {numeroLegible}
      </a>
      {INSTAGRAM_URL && (
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" data-ubicacion="footer" class="mt-2 flex items-center gap-2 font-body text-sm text-canvas/65 hover:text-gold">
          <svg viewBox="0 0 16 16" class="h-4 w-4 shrink-0 fill-current" aria-hidden="true">
            <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.269.087 3.85.048 4.703.01 5.556 0 5.829 0 8s.01 2.444.048 3.297c.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.556 15.99 5.829 16 8 16s2.444-.01 3.297-.048c.852-.04 1.433-.174 1.942-.372a3.9 3.9 0 0 0 1.417-.923c.444-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.444 16 10.171 16 8s-.01-2.444-.048-3.297c-.04-.852-.175-1.433-.372-1.942a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.091-.333-1.943-.372C10.443.01 10.17 0 7.998 0zm-.717 1.442h.717c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.276.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.47 2.47 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.48 2.48 0 0 1-.92-.598 2.48 2.48 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233 0-2.136.008-2.388.046-3.231.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.033 1.024-.043 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334" />
          </svg>
          @{instagramHandle}
        </a>
      )}
    </div>

    <div>
      <p class="font-body text-sm font-semibold text-canvas">Diferenciales</p>
      <ul class="mt-3 space-y-2 font-body text-sm text-canvas/65">
        <li>Sin seña, abonás al ingresar</li>
        <li>Descuento pagando en efectivo</li>
        <li>Reubicación asegurada ante una emergencia</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-canvas/15">
    {/* grid de 3 columnas iguales (1fr auto 1fr) en vez de flex
       justify-between: con justify-between el del medio solo queda
       centrado si los textos de los costados miden parecido - acá
       "© 2026..." y "Sitio realizado por /deploy_" no pesan igual, así que
       Privacidad/Términos quedaba corrido. Con las columnas 1 y 3 del
       mismo ancho (1fr cada una), la columna del medio SÍ cae en el centro
       real del bloque, sin importar cuánto pesen los textos de los lados. */}
    <div class="mx-auto grid max-w-[90rem] grid-cols-1 items-center gap-2 px-0 py-5 text-center font-body text-xs text-canvas/50 sm:px-0 md:grid-cols-[1fr_auto_1fr] md:text-left">
      <p>© {anio} {SITE.nombre}. Todos los derechos reservados.</p>
      <p class="flex justify-center gap-4">
        <a href="/privacidad/" class="hover:text-gold">Privacidad</a>
        <a href="/terminos/" class="hover:text-gold">Términos y condiciones</a>
      </p>
      <p class="md:text-right">
        Sitio realizado por{" "}
        <a
          href="https://deploystudio.com.ar/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-canvas/70 transition-colors hover:text-gold"
        >
          /deploy_
        </a>
      </p>
    </div>
  </div>
</footer>
