---
import MarginLines from "./MarginLines.astro";

const secundarios = [
  {
    titulo: "Amplia disponibilidad",
    texto:
      "Departamentos de 1 a 5 personas. Te ofrecemos alternativas según la cantidad de huéspedes, fechas disponibles, ubicación preferida y estilo de estadía, para que puedas comparar opciones y elegir con tranquilidad.",
    path: "M4 21V9a2 2 0 0 1 2-2h3V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v3h3a2 2 0 0 1 2 2v12 M4 21h16 M9 21v-5h6v5",
  },
  {
    titulo: "Descuento en efectivo",
    texto: "Pagando en efectivo tenés un descuento sobre el valor de la estadía.",
    path: "M2 6a1 1 0 0 1 1-1h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6z M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z M5 9v.01 M19 15v.01",
  },
  {
    titulo: "Atención familiar",
    texto: "Somos tres personas, una familia, y siempre te atendemos nosotros, de punta a punta.",
    path: "M17 20v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2 M10 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M21 20v-2a4 4 0 0 0-3-3.87 M15.5 4.13a4 4 0 0 1 0 7.75",
  },
];
---

<section class="relative border-y border-hairline bg-canvas">
  <MarginLines side="right" variant="b" />
  <div class="mx-auto max-w-[90rem] px-4 py-16 sm:px-6 lg:py-24">
    <div class="max-w-xl">
      <h2 class="font-display text-4xl leading-[1.05] text-ink sm:text-5xl">
        Sin seña.
        <br />
        Abonás al ingresar.
      </h2>
      <p class="mt-5 font-body text-base text-muted">
        Es el diferencial que más nos preguntan: no vas a transferir nada por
        adelantado para reservar. Coordinamos todo por WhatsApp y pagás
        recién cuando llegás al departamento.
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        secundarios.map((d) => (
          <div class="rounded-2xl border border-hairline bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-gold-active hover:shadow-xl hover:shadow-ink/10">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-canvas text-gold-active">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={d.path} />
              </svg>
            </span>
            <h3 class="mt-4 font-display text-lg text-ink">{d.titulo}</h3>
            <p class="mt-2 font-body text-sm leading-relaxed text-muted">{d.texto}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-8 rounded-2xl border border-dashed border-hairline bg-surface/60 p-6">
      <p class="font-body text-sm font-semibold text-ink">Importante sobre la asignación de departamentos</p>
      <p class="mt-2 font-body text-sm leading-relaxed text-muted">
        En Santilli Aparts trabajamos con una amplia variedad de departamentos
        en Recoleta y Palermo. Por situaciones excepcionales, especialmente
        relacionadas con salud o extensiones de estadía de huéspedes ya
        alojados, la unidad asignada podría modificarse. En ese caso, siempre
        se ofrecerá otro departamento de características similares,
        respetando la zona, comodidad y condiciones acordadas.
      </p>
    </div>
  </div>
</section>
