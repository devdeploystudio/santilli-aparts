---
import { getEntry } from "astro:content";
import MarginLines from "./MarginLines.astro";
import Icon from "./Icon.astro";
import { imageSize } from "../lib/imageSize";

const d = (await getEntry("configDiferenciales", "diferenciales"))!.data;
const fotoFondoSize = await imageSize(d.fotoFondo);
---

<section class="relative overflow-hidden border-y border-hairline">
  <img
    src={d.fotoFondo}
    alt={d.fotoFondoAlt ?? ""}
    draggable="false"
    loading="lazy"
    width={fotoFondoSize?.width}
    height={fotoFondoSize?.height}
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-ink/75" />
  <MarginLines side="right" variant="b" tono="white" />
  <div class="relative mx-auto max-w-[90rem] px-7 py-16 sm:px-10 lg:py-24">
    <div class="max-w-xl">
      <h2 class="font-display text-4xl leading-[1.05] text-canvas sm:text-5xl">
        {d.titulo}
      </h2>
      <p class="mt-5 font-body text-base text-canvas/90">
        {d.texto}
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        d.cards.map((card) => (
          <div class="rounded-2xl border border-hairline bg-surface/90 p-6 shadow-lg shadow-ink/20 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-gold-active hover:bg-surface hover:shadow-xl">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-canvas text-gold-active">
              <Icon icono={card.icono} class="h-5 w-5" />
            </span>
            <h3 class="mt-4 font-display text-lg text-ink">{card.titulo}</h3>
            <p class="mt-2 font-body text-sm leading-relaxed text-muted">{card.texto}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-8 rounded-2xl border border-dashed border-hairline bg-surface/90 p-6 shadow-lg shadow-ink/20 backdrop-blur-sm">
      <p class="font-body text-sm font-semibold text-ink">{d.importanteTitulo}</p>
      <p class="mt-2 font-body text-sm leading-relaxed text-muted">
        {d.importanteTexto}
      </p>
    </div>
  </div>
</section>
