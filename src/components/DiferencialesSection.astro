---
import { getEntry } from "astro:content";
import MarginLines from "./MarginLines.astro";
import { imageSize } from "../lib/imageSize";

const d = (await getEntry("configDiferenciales", "diferenciales"))!.data;
const fotoFondoSize = await imageSize(d.fotoFondo);

// Los íconos quedan fijos en código (parte del diseño, no del contenido);
// título/texto de cada tarjeta se editan desde /admin.
const secundarios = [
  {
    titulo: d.secundario1Titulo,
    texto: d.secundario1Texto,
    path: "M4 21V9a2 2 0 0 1 2-2h3V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v3h3a2 2 0 0 1 2 2v12 M4 21h16 M9 21v-5h6v5",
  },
  {
    titulo: d.secundario2Titulo,
    texto: d.secundario2Texto,
    path: "M2 6a1 1 0 0 1 1-1h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6z M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z M5 9v.01 M19 15v.01",
  },
  {
    titulo: d.secundario3Titulo,
    texto: d.secundario3Texto,
    path: "M17 20v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2 M10 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M21 20v-2a4 4 0 0 0-3-3.87 M15.5 4.13a4 4 0 0 1 0 7.75",
  },
];
---

<section class="relative overflow-hidden border-y border-hairline">
  <img
    src={d.fotoFondo}
    alt=""
    draggable="false"
    loading="lazy"
    width={fotoFondoSize?.width}
    height={fotoFondoSize?.height}
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-ink/75" />
  <MarginLines side="right" variant="b" tono="white" />
  <div class="relative mx-auto max-w-[90rem] px-4 py-16 sm:px-6 lg:py-24">
    <div class="max-w-xl">
      <h2 class="font-display text-4xl leading-[1.05] text-canvas sm:text-5xl">
        {d.titulo}
      </h2>
      <p class="mt-5 font-body text-base text-canvas/90">
        {d.texto}
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        secundarios.map((d) => (
          <div class="rounded-2xl border border-hairline bg-surface/90 p-6 shadow-lg shadow-ink/20 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-gold-active hover:bg-surface hover:shadow-xl">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-canvas text-gold-active">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={d.path} />
              </svg>
            </span>
            <h3 class="mt-4 font-display text-lg text-ink">{d.titulo}</h3>
            <p class="mt-2 font-body text-sm leading-relaxed text-muted">{d.texto}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-8 rounded-2xl border border-dashed border-hairline bg-surface/90 p-6 shadow-lg shadow-ink/20 backdrop-blur-sm">
      <p class="font-body text-sm font-semibold text-ink">{d.importanteTitulo}</p>
      <p class="mt-2 font-body text-sm leading-relaxed text-muted">
        {d.importanteTexto}
      </p>
    </div>
  </div>
</section>
