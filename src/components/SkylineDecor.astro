---
// Dibujo decorativo del skyline (currentColor, ver SkylineMark) reusado en
// cualquier sección con foto de fondo oscura — mismo gesto de "dibujado" que
// el Hero, pero re-jugado cada vez que ESA sección entra en pantalla (subir
// o bajar), no solo la primera vez. Un solo script genérico (por clase, no
// por id) sirve para todas las instancias de este componente en la página,
// Astro dedupea el <script> automáticamente.
import SkylineMark from "./SkylineMark.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class={`skyline-decor pointer-events-none absolute text-white opacity-35 ${className}`}>
  <SkylineMark class="w-full" />
</div>

<script>
  function initSkylineDecor() {
    const els = document.querySelectorAll<HTMLElement>(".skyline-decor:not([data-skyline-bound])");
    if (els.length === 0) return;

    const reducirMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    els.forEach((el) => {
      el.dataset.skylineBound = "true";

      if (reducirMovimiento || !("IntersectionObserver" in window)) {
        el.classList.add("skyline-in-view");
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              el.classList.remove("skyline-in-view");
              void el.offsetWidth;
              el.classList.add("skyline-in-view");
            } else {
              el.classList.remove("skyline-in-view");
            }
          }
        },
        { threshold: 0.3 },
      );

      observer.observe(el);
    });
  }

  initSkylineDecor();
  document.addEventListener("astro:page-load", initSkylineDecor);
</script>
