---
import { getEntry } from "astro:content";
import MarginLines from "./MarginLines.astro";

const c = (await getEntry("configComoTrabajamos", "como-trabajamos"))!.data;

const pasos = [
  { n: "01", titulo: c.paso1Titulo, texto: c.paso1Texto },
  { n: "02", titulo: c.paso2Titulo, texto: c.paso2Texto },
  { n: "03", titulo: c.paso3Titulo, texto: c.paso3Texto },
  { n: "04", titulo: c.paso4Titulo, texto: c.paso4Texto },
];
---

<section id="como-se-reserva" class="relative scroll-mt-24 border-y border-hairline bg-surface">
  <MarginLines side="left" />
  <div class="mx-auto max-w-[90rem] px-7 py-16 sm:px-10 lg:py-24">
  <h2 class="font-display text-3xl text-ink sm:text-4xl">{c.titulo}</h2>
  <p class="mt-3 max-w-2xl font-body text-base text-muted">
    {c.texto}
  </p>

  <div id="proceso-track" class="timeline-track mt-12 h-[3px] w-full rounded-full" style="--progress: 0%"></div>

  <ol class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      pasos.map((p) => (
        <li>
          <span class="font-display text-3xl text-gold">{p.n}</span>
          <h3 class="mt-2 font-display text-lg text-ink">{p.titulo}</h3>
          <p class="mt-1.5 font-body text-sm text-muted">{p.texto}</p>
        </li>
      ))
    }
  </ol>

  <div class="mt-8 rounded-2xl border border-dashed border-hairline bg-canvas p-6">
    <p class="font-body text-sm font-semibold text-ink">{c.reservaTitulo}</p>
    <p class="mt-2 font-body text-sm leading-relaxed text-muted">
      {c.reservaTexto}
    </p>
  </div>
  </div>
</section>

<script>
  const section = document.getElementById("proceso-track")?.closest("section");
  const track = document.getElementById("proceso-track");
  if (section && track) {
    const onScroll = () => {
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight;
      // 0% cuando el techo de la sección entra al 75% del viewport,
      // 100% cuando su piso cruza el 40% del viewport.
      const start = vh * 0.75;
      const end = vh * 0.4;
      const progress = Math.min(1, Math.max(0, (start - rect.top) / (rect.height + start - end)));
      track.style.setProperty("--progress", `${progress * 100}%`);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }
</script>
