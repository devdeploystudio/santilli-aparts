---
import { NAV_LINKS, SITE, WHATSAPP_NUMBER } from "../config/site";
import { buildConsultaGeneralLink } from "../lib/whatsapp";

const waLink = buildConsultaGeneralLink(WHATSAPP_NUMBER);
---

<header class="sticky top-0 z-40 border-b border-hairline bg-surface/90 backdrop-blur">
  <div class="mx-auto flex max-w-[90rem] items-center justify-between gap-4 px-7 py-3 sm:px-10">
    <a href="/" class="flex items-center gap-2.5">
      {/* aspect-[...] en vez de un cuadrado: el ícono real es rectangular
         (~1.27:1) - forzarlo a un cuadrado (como icon-192.png, pensado
         para favicon/PWA) lo dejaba chico y corrido hacia abajo dentro de
         su propio marco. icon-gold.png ya viene recortado a la proporción
         real, sin el margen extra que necesita un ícono cuadrado. */}
      <img src="/icon-gold.png" alt="" width="443" height="350" draggable="false" loading="eager" class="h-8 w-auto sm:h-9" />
      <span class="font-display text-lg leading-none text-ink sm:text-xl">
        Santilli <span class="text-gold-active">Aparts</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex xl:gap-8" aria-label="Principal">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="nav-link whitespace-nowrap font-body text-sm font-medium text-ink transition-colors hover:text-gold-active"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
      data-ubicacion="header"
      class="btn-press hidden rounded-full bg-gold px-5 py-2.5 font-body text-sm font-semibold text-ink transition-colors hover:bg-gold-active lg:inline-block"
    >
      Consultar por WhatsApp
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-hairline lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Abrir menú</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line class="menu-toggle__line menu-toggle__line--top" x1="3" y1="6" x2="21" y2="6"></line>
        <line class="menu-toggle__line menu-toggle__line--middle" x1="3" y1="12" x2="21" y2="12"></line>
        <line class="menu-toggle__line menu-toggle__line--bottom" x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Principal (mobile)"
    class="mobile-menu absolute inset-x-0 top-full flex flex-col gap-1 border-t border-hairline bg-surface px-7 py-3 shadow-lg lg:hidden"
  >
    {
      NAV_LINKS.map((link) => (
        <a href={link.href} class="rounded-lg px-3 py-2.5 font-body text-sm font-medium text-ink hover:bg-canvas">
          {link.label}
        </a>
      ))
    }
    <a
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
      data-ubicacion="header"
      class="btn-press mt-1 rounded-full bg-gold px-5 py-2.5 text-center font-body text-sm font-semibold text-ink"
    >
      Consultar por WhatsApp
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("is-open");
    toggle.classList.toggle("is-open", isOpen);
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });

  // Alto real del navbar como variable CSS, para que el Hero (u otra
  // sección) pueda calcular "el resto de la pantalla" exacto (100svh menos
  // esto) sin adivinar un número fijo a mano - antes el Hero asumía 4.5rem
  // (72px) hardcodeado, pero el navbar real mide ~64.7px, dejando un
  // sobrante y el conjunto navbar+Hero sin llenar la pantalla justo.
  // ResizeObserver (no solo un listener de "resize" de window) porque el
  // alto del propio header puede cambiar por otros motivos además del
  // ancho de ventana - un salto de fuente al cargar, por ejemplo.
  const header = document.querySelector("header");
  if (header && "ResizeObserver" in window) {
    const actualizarAltoNavbar = () => {
      document.documentElement.style.setProperty("--header-h", `${header.offsetHeight}px`);
    };
    actualizarAltoNavbar();
    new ResizeObserver(actualizarAltoNavbar).observe(header);
  }
</script>
