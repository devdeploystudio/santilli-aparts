---
import { getEntry } from "astro:content";
import ServiceIcon, { SERVICIO_LABELS, type ServicioKey } from "./ServiceIcon.astro";
import MarginLines from "./MarginLines.astro";

const q = (await getEntry("configQueIncluye", "que-incluye"))!.data;

// Íconos y orden quedan fijos en código; el texto de cada servicio se
// edita desde /admin.
const items: { key: ServicioKey; texto: string }[] = [
  { key: "ropaBlanca", texto: q.ropaBlancaTexto },
  { key: "wifi", texto: q.wifiTexto },
  { key: "tv", texto: q.tvTexto },
  { key: "cocina", texto: q.cocinaTexto },
  { key: "aire", texto: q.aireTexto },
  { key: "seguridad", texto: q.seguridadTexto },
  { key: "amenities", texto: q.amenitiesTexto },
  { key: "cochera", texto: q.cocheraTexto },
];
---

<section class="relative border-y border-hairline bg-canvas">
  <MarginLines side="right" variant="b" />
  <div class="mx-auto max-w-[90rem] px-4 py-16 sm:px-6 lg:py-24">
    <div class="relative overflow-hidden rounded-3xl">
      <img
        src="/departamentos/depto-12-av-callao-930/02.jpg"
        alt=""
        draggable="false"
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/60 to-ink/25" />
      <div class="relative max-w-xl px-6 py-12 sm:px-10 sm:py-16">
        <h2 class="font-display text-3xl text-canvas sm:text-4xl">{q.titulo}</h2>
        <p class="mt-3 font-body text-base text-canvas/90">
          {q.texto}
        </p>
      </div>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((item) => (
          <div class="group rounded-2xl border border-hairline bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-gold-active hover:shadow-xl hover:shadow-ink/10">
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-canvas text-gold-active shadow-sm transition-transform duration-300 group-hover:scale-110">
              <ServiceIcon servicio={item.key} class="h-7 w-7" />
            </span>
            <h3 class="mt-5 font-display text-lg text-ink">{SERVICIO_LABELS[item.key]}</h3>
            <p class="mt-2 font-body text-sm leading-relaxed text-muted">{item.texto}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
