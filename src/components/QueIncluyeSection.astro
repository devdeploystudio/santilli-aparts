---
import { getEntry } from "astro:content";
import Icon from "./Icon.astro";
import MarginLines from "./MarginLines.astro";
import { imageSize } from "../lib/imageSize";

const q = (await getEntry("configQueIncluye", "que-incluye"))!.data;
const fotoFondoSize = await imageSize(q.fotoFondo);
---

<section class="relative overflow-hidden border-y border-hairline">
  <img
    src={q.fotoFondo}
    alt=""
    draggable="false"
    loading="lazy"
    width={fotoFondoSize?.width}
    height={fotoFondoSize?.height}
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-ink/75" />
  <MarginLines side="right" variant="b" tono="white" />
  <div class="relative mx-auto max-w-[90rem] px-7 py-16 sm:px-10 lg:py-24">
    <div class="max-w-xl">
      <h2 class="font-display text-3xl text-canvas sm:text-4xl">{q.titulo}</h2>
      <p class="mt-3 font-body text-base text-canvas/90">
        {q.texto}
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        q.items.map((item) => (
          <div class="group rounded-2xl border border-hairline bg-surface/90 p-6 shadow-lg shadow-ink/20 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-gold-active hover:bg-surface hover:shadow-xl">
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-canvas text-gold-active shadow-sm transition-transform duration-300 group-hover:scale-110">
              <Icon icono={item.icono} class="h-7 w-7" />
            </span>
            <h3 class="mt-5 font-display text-lg text-ink">{item.titulo}</h3>
            <p class="mt-2 font-body text-sm leading-relaxed text-muted">{item.texto}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
