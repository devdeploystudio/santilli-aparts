---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ServiceIcon, { SERVICIO_LABELS } from "../../components/ServiceIcon.astro";
import Gallery from "../../components/Gallery.tsx";
import MapView from "../../components/MapView.tsx";
import BookingForm from "../../components/BookingForm.tsx";
import { resaltarServicios } from "../../lib/highlight";
import { WHATSAPP_NUMBER } from "../../config/site";

export async function getStaticPaths() {
  const departamentos = await getCollection("departamentos");
  return departamentos.map((depto) => ({
    params: { slug: depto.id },
    props: { depto },
  }));
}

const { depto } = Astro.props;
const {
  nombre,
  zona,
  direccion,
  coords,
  capacidadMin,
  capacidadMax,
  descripcionBreve,
  servicios,
  fotos,
  video,
  videoPoster,
  esPlaceholder,
} = depto.data;

const capacidadTexto =
  capacidadMin === capacidadMax
    ? `${capacidadMax} ${capacidadMax === 1 ? "persona" : "personas"}`
    : `${capacidadMin} a ${capacidadMax} personas`;
---

<Layout title={nombre} description={descripcionBreve}>
  <section class="mx-auto max-w-[90rem] px-5 py-12 sm:px-7">
    <a href="/departamentos/" class="font-body text-sm text-muted hover:text-gold-active">← Volver a departamentos</a>

    <div class="mt-4">
      <h1 class="font-display text-3xl text-ink sm:text-4xl">{nombre}</h1>
      <p class="mt-1.5 font-body text-base font-semibold text-gold-active">{zona}</p>
    </div>

    <div class="mt-8 grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-stretch">
      <div id="galeria-columna">
        <Gallery client:visible fotos={fotos} esPlaceholder={esPlaceholder} nombre={nombre} video={video} videoPoster={videoPoster} />
      </div>

      <div>
        <h2 class="font-display text-xl text-ink">Sobre este departamento</h2>
        <p class="mt-3 font-body text-sm text-muted" set:html={resaltarServicios(descripcionBreve)} />
        <p class="mt-2 font-body text-xs text-muted">{direccion}</p>

        <span class="mt-4 inline-block rounded-full border border-hairline px-3 py-1.5 font-body text-xs text-ink">
          {capacidadTexto}
        </span>

        <div class="mt-8">
          <h2 class="font-display text-xl text-ink">Servicios incluidos</h2>
          <div class="mt-4 rounded-2xl border border-hairline bg-surface p-6">
            {servicios.length > 0 ? (
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
                {
                  servicios.map((s) => (
                    <div class="flex items-center gap-3">
                      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-canvas text-gold-active">
                        <ServiceIcon servicio={s} class="h-4 w-4" />
                      </span>
                      <span class="font-body text-sm text-ink">{SERVICIO_LABELS[s]}</span>
                    </div>
                  ))
                }
              </div>
            ) : (
              <p class="font-body text-sm text-muted">Detalles a confirmar por WhatsApp.</p>
            )}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-stretch">
      <div class="flex flex-col">
        <div class="h-80 flex-1 overflow-hidden rounded-2xl bg-canvas lg:h-auto">
          <MapView client:only="preact" pines={[{ nombre, lat: coords.lat, lng: coords.lng }]} zoom={15} className="h-full w-full" />
        </div>
      </div>

      <div>
        <BookingForm client:visible nombreDepto={nombre} whatsappNumero={WHATSAPP_NUMBER} />
      </div>
    </div>
  </section>
</Layout>
