---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import DepartamentosExplorer, { type DeptoResumen } from "../../components/DepartamentosExplorer.tsx";
import { resolverPortada } from "../../lib/portada";
import { imageSize } from "../../lib/imageSize";

// El orden se arrastra en el panel (reorder: { key: orden }) - el loader
// glob() no garantiza ningún orden propio.
const departamentos = (await getCollection("departamentos")).sort((a, b) => a.data.orden - b.data.orden);

const resumen: DeptoResumen[] = await Promise.all(
  departamentos.map(async (d) => {
    const portada = resolverPortada(d.data);
    const size = portada.foto ? await imageSize(portada.foto) : null;
    return {
      slug: d.id,
      nombre: d.data.nombre,
      zona: d.data.zona,
      capacidadMax: d.data.capacidadMax,
      esPlaceholder: d.data.esPlaceholder,
      ...portada,
      fotoWidth: size?.width,
      fotoHeight: size?.height,
    };
  }),
);
---

<Layout
  title="Departamentos"
  description="Explorá los departamentos disponibles en Recoleta, Palermo y Balvanera, y filtrá por barrio o cantidad de personas."
>
  <section class="mx-auto max-w-[90rem] px-7 pt-16 sm:px-10">
    <h1 class="font-display text-4xl text-ink sm:text-5xl">Departamentos</h1>
    <p class="mt-3 font-body text-base text-muted">
      Filtrá según lo que necesites. Los precios y la disponibilidad exacta se
      confirman por WhatsApp.
    </p>
  </section>

  <section data-no-reveal class="mx-auto max-w-[90rem] px-7 pb-16 sm:px-10">
    <div class="mt-8">
      <DepartamentosExplorer client:load deptos={resumen} />
    </div>
  </section>
</Layout>
