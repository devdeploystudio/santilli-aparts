---
import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { WHATSAPP_NUMBER } from "../config/site";
import { buildConsultaGeneralLink } from "../lib/whatsapp";
import { imageSize } from "../lib/imageSize";
import Icon from "../components/Icon.astro";

const waLink = buildConsultaGeneralLink(WHATSAPP_NUMBER);
const n = (await getEntry("configNosotros", "nosotros"))!.data;
const fotoSize = await imageSize(n.foto);

// Lista dinámica (agregar/borrar/reordenar desde el panel), con ícono
// elegible - antes 3 puntos fijos (punto1/2/3) con un dibujo fijo en código.
const puntos = n.puntos;
---

<Layout
  title="Nosotros: una familia, no una empresa"
  description="Santilli Aparts es un negocio familiar: somos tres personas y siempre te atendemos nosotros, desde la consulta hasta el ingreso."
>
  <section class="grid lg:grid-cols-2 lg:items-stretch">
    <div data-cursor-dark class="group h-72 overflow-hidden sm:h-96 lg:h-auto lg:order-1">
      <img
        src={n.foto}
        alt={n.fotoAlt || "La familia Santilli, dueños y responsables de Santilli Aparts"}
        loading="lazy"
        width={fotoSize?.width}
        height={fotoSize?.height}
        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
      />
    </div>

    <div class="flex flex-col justify-center px-7 py-16 sm:px-10 lg:order-2 lg:py-24 lg:pl-16 lg:pr-[max(2.5rem,calc((100vw-90rem)/2+2.5rem))]">
      <h1 class="font-display text-4xl leading-[1.1] text-ink sm:text-5xl">
        {n.titulo}
      </h1>
      <p class="mt-5 font-body text-base text-muted">
        {n.texto1}
      </p>
      <p class="mt-4 font-body text-base text-muted">
        {n.texto2}
      </p>

      <a
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        data-ubicacion="pagina_nosotros"
        class="btn-press mt-8 inline-block w-fit rounded-full bg-gold px-6 py-3.5 font-body text-sm font-semibold text-ink transition-colors hover:bg-gold-active"
      >
        Escribinos por WhatsApp
      </a>

      <div class="mt-12 grid gap-5">
        {
          puntos.map((p) => (
            <div class="rounded-2xl border border-hairline bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-gold-active hover:shadow-lg hover:shadow-ink/10">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-canvas text-gold-active">
                <Icon icono={p.icono} class="h-[18px] w-[18px]" />
              </span>
              <h2 class="mt-3 font-display text-lg text-ink">{p.titulo}</h2>
              <p class="mt-1.5 font-body text-sm leading-relaxed text-muted">{p.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
