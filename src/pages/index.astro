---
import { getCollection, getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import DiferencialesSection from "../components/DiferencialesSection.astro";
import ZonaSection from "../components/ZonaSection.astro";
import QueIncluyeSection from "../components/QueIncluyeSection.astro";
import ComoTrabajamos from "../components/ComoTrabajamos.astro";
import Reviews from "../components/Reviews.astro";
import CtaBanner from "../components/CtaBanner.astro";
import ApartmentCarousel from "../components/ApartmentCarousel.astro";
import MarginLines from "../components/MarginLines.astro";
import AyudaElegirForm from "../components/AyudaElegirForm.tsx";
import { WHATSAPP_NUMBER } from "../config/site";
import { resolverPortada } from "../lib/portada";
import { numeroDepto } from "../lib/numeroDepto";

// El orden se arrastra en el panel (reorder: { key: orden }, ver colección
// "departamentos" en config.yml) - el loader glob() no garantiza ningún
// orden propio, así que hay que ordenar acá siempre que se lean todos.
const departamentos = (await getCollection("departamentos")).sort((a, b) => a.data.orden - b.data.orden);
const deptos = (await getEntry("configInicioDeptos", "inicioDeptos"))!.data;
const ayuda = (await getEntry("configInicioAyuda", "inicioAyuda"))!.data;
const cta = (await getEntry("configInicioCta", "inicioCta"))!.data;

// Carrusel del home: si el cliente eligió a mano cuáles mostrar en
// "Inicio → Nuestros departamentos", se respeta esa selección; si
// todavía no eligió ninguno, se muestran TODOS los departamentos - mejor
// no ocultar nada por default hasta que el cliente arme su propia
// selección curada.
const seleccionCarrusel =
  deptos.deptosDestacados.length > 0
    ? deptos.deptosDestacados
        .map((id) => departamentos.find((d) => d.id === id))
        .filter((d): d is NonNullable<typeof d> => Boolean(d))
    : departamentos;

// El ORDEN de esa selección puede venir de dos lugares (checkbox
// "seguirOrdenDepartamentos" en el panel, ver content.config.ts): por
// default, siempre en vivo según "orden" de Departamentos (si el cliente
// reordena ahí, el carrusel se actualiza solo); si el cliente lo
// destildó, se respeta tal cual el orden en que arrastró los ítems
// dentro de "deptosDestacados" (un orden propio del carrusel).
if (deptos.seguirOrdenDepartamentos) {
  seleccionCarrusel.sort((a, b) => a.data.orden - b.data.orden);
}

const muestra = seleccionCarrusel.map((d) => ({
  slug: d.id,
  nombre: d.data.nombre,
  zona: d.data.zona,
  numero: numeroDepto(d.id),
  esPlaceholder: d.data.esPlaceholder,
  ...resolverPortada(d.data),
}));
---

<Layout title="Alquiler temporario en Recoleta y Palermo">
  <Hero />

  <section class="relative border-t border-hairline bg-surface">
    <MarginLines side="left" />
    <div class="mx-auto max-w-[90rem] px-7 py-16 sm:px-10">
    <ApartmentCarousel deptos={muestra} titulo={deptos.titulo} texto1={deptos.texto1} texto2={deptos.texto2} />

    <div class="mt-14 grid gap-10 rounded-2xl border border-hairline bg-canvas p-6 sm:p-10 lg:grid-cols-2 lg:items-center">
      <div class="lg:pl-6">
        <h3 class="font-display text-2xl text-ink sm:text-3xl">{ayuda.titulo}</h3>
        <p class="mt-3 max-w-md font-body text-base text-muted">
          {ayuda.texto}
        </p>

        <ul class="mt-6 space-y-3">
          {
            ayuda.items.map((item) => (
              <li class="flex items-center gap-2.5 font-body text-sm text-ink">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gold/20 text-gold-active">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12l5 5L20 7" />
                  </svg>
                </span>
                {item.texto}
              </li>
            ))
          }
        </ul>
      </div>
      <AyudaElegirForm client:visible whatsappNumero={WHATSAPP_NUMBER} />
    </div>
    </div>
  </section>

  <DiferencialesSection />
  <ZonaSection />
  <QueIncluyeSection />
  <ComoTrabajamos />
  <Reviews />
  <CtaBanner titulo={cta.titulo} texto={cta.texto} foto={cta.foto} fotoAlt={cta.fotoAlt} botonTexto={cta.botonTexto} />
</Layout>
