---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BrandCursor from "../components/BrandCursor.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import LoadingScreen from "../components/LoadingScreen.astro";
import { SITE } from "../config/site";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.descripcion, image = "/departamentos/depto-20-callao-966/01.jpg" } = Astro.props;
const pageTitle = `${SITE.nombre} - ${title}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#cca038" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body class="flex min-h-screen flex-col">
    <LoadingScreen />
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <BrandCursor />
    <ScrollReveal />
  </body>
</html>
